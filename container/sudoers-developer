# Passwordless sudo for developer in every flavor.
#
# Standard container launches must pass --security-opt no-new-privileges to
# block elevation. The -sudo compatibility profiles (or SECURITY_OPTS=) omit
# that flag. Raw engine invocations without the flag also permit elevation.
# VM guests permit administration out of the box, with no shared password.
#
# The rootless container or microVM is the outer boundary, not this grant.
# Guest/container root can access credentials and files shared into it; do not
# expose sensitive host paths or a host container-engine socket by default.
# Setting a user password alone does not change this NOPASSWD policy.
developer ALL=(ALL) NOPASSWD: ALL
