# Compatibility container profile: same payload as slim, including sudo.
# Makefile launches this flavor without no-new-privileges so sudo can elevate.
# Raw engine launches choose their own security policy regardless of the tag.
ARG BASE_IMAGE=localhost/bb-stage-slim:dev
FROM ${BASE_IMAGE} AS slim-sudo

CMD ["bash", "/home/developer/entrypoint.sh"]
LABEL sh.bb.flavor="slim-sudo"
