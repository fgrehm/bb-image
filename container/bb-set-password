#!/bin/sh
# Set developer's password and retire the image-owned bootstrap sudo grant.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

fail() {
	printf '%s\n' "$*" >&2
	exit 1
}

[ "$#" = 0 ] || fail 'Usage: sudo bb-set-password (sets the developer password)'
[ "$(id -u)" = 0 ] || fail 'Run sudo bb-set-password. A no-new-privileges container cannot elevate.'

# Serialize concurrent setup attempts without holding a lock on a renamed file.
exec 9>/run/bb-set-password.lock
flock -n 9 || fail 'Another password setup is in progress.'

permanent=/etc/sudoers.d/developer
bootstrap=/etc/sudoers.d/zz-bb-bootstrap
backup=
rollback=0
cleanup() {
	if [ "$rollback" = 1 ] && [ -s "$backup" ] && [ ! -e "$bootstrap" ]; then
		if mv -f "$backup" "$bootstrap"; then
			printf '%s\n' 'Password may have changed, but bootstrap passwordless sudo was restored. Resolve the policy error and rerun sudo bb-set-password.' >&2
		else
			printf 'Cannot restore bootstrap sudo. Keep this root session and inspect %s.\n' "$backup" >&2
			return 1
		fi
	fi
	[ -z "$backup" ] || rm -f "$backup"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Refuse to rewrite a customized policy or operate on a broken sudoers stack.
[ -f "$permanent" ] && [ ! -L "$permanent" ] || fail 'Missing image-managed password-required sudo grant.'
[ "$(stat -c '%u:%a' "$permanent")" = 0:440 ] || fail 'Password-required sudo grant must be root-owned and mode 0440.'
[ "$(grep -vE '^[[:space:]]*(#.*)?$' "$permanent")" = 'developer ALL=(ALL) PASSWD: ALL' ] || fail 'Custom sudo policy detected. Configure it manually.'
visudo -c >/dev/null || fail 'Sudo policy is invalid; no password or policy changes made.'

if [ -e "$bootstrap" ]; then
	[ -f "$bootstrap" ] && [ ! -L "$bootstrap" ] || fail 'Unexpected bootstrap grant type.'
	[ "$(stat -c '%u:%a' "$bootstrap")" = 0:440 ] || fail 'Bootstrap grant must be root-owned and mode 0440.'
	[ "$(grep -vE '^[[:space:]]*(#.*)?$' "$bootstrap")" = 'developer ALL=(ALL) NOPASSWD: ALL' ] || fail 'Custom bootstrap policy detected. Configure it manually.'
fi

printf '%s\n' 'Set a password for developer. Successful setup disables the image bootstrap passwordless sudo grant.'
passwd developer || fail 'Password setup failed or was cancelled; sudo policy was not changed.'
status="$(passwd -S developer | awk '{print $2}')"
[ "$status" = P ] || fail 'No password hash reported; sudo policy was not changed.'

if [ -e "$bootstrap" ]; then
	# Names with a dot are ignored by sudoers. Rename is the policy transition.
	backup="$(mktemp /etc/sudoers.d/.bb-bootstrap.XXXXXX)"
	rollback=1
	mv -f "$bootstrap" "$backup"
fi
visudo -c >/dev/null || fail 'Policy validation failed after password setup.'
# -k ignores cached authentication. An extra NOPASSWD grant must not silently win.
if runuser -u developer -- sudo -n -k true >/dev/null 2>&1; then
	fail 'Another policy still permits passwordless sudo. Setup is not complete.'
fi
runuser -u developer -- sudo -K
rollback=0
printf '%s\n' 'Password set. Image bootstrap passwordless sudo is disabled; future sudo commands require your password.'
printf '%s\n' 'Container recreation resets this setup; VM disk state preserves it. Ordinary passwd does not switch sudo policy.'
