# Image-owned listener default for exe.dev, which shares the VM unit. The
# exe.dev proxy reaches the guest over the network, so exposing bb needs
# BB_SERVER_BIND_HOST=0.0.0.0 in /etc/default/bb and a service restart. Port
# 3000 is the proxy's first forwarded port. See docs/exedev.md.
BB_SERVER_BIND_HOST=127.0.0.1
BB_SERVER_PORT=3000
