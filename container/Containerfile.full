# ---------------------------------------------------------------------------
# full: worker's Node, sudo, lazy agent CLIs and Playwright/Chromium, plus bb,
# the build toolchain, baked dev tools, backups and document/image support.
# Slim stays on the browser-free foundation rather than this branch.
# ---------------------------------------------------------------------------

ARG BASE_IMAGE=localhost/bb-stage-worker:dev
FROM ${BASE_IMAGE} AS full

ARG DEBIAN_FRONTEND
ARG USERNAME
ARG BUILD_SCRATCH
ARG BB_VERSION

USER root
COPY container/packages-full.txt /tmp/packages-full.txt
RUN apt-get update \
    && grep -vE '^(\s*(#.*)?)$' /tmp/packages-full.txt \
       | xargs apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* /tmp/packages-full.txt
USER $USERNAME

# bb lives in the shared mise Node install. The inherited worker config has
# runtime cache overrides, so invoke npm with Node's bin ahead of the shims:
# no shim activation can redirect this RUN's scratch cache into persistent home.
# Native install scripts must be allowed explicitly or bb fails at runtime.
RUN --mount=type=secret,id=github_token,required=false,uid=1000,gid=1000,mode=0400 \
    set -e; \
    if [ -s /run/secrets/github_token ]; then \
      export MISE_GITHUB_TOKEN="$(cat /run/secrets/github_token)"; \
    fi; \
    export npm_config_cache="$BUILD_SCRATCH/npm" \
           XDG_CACHE_HOME="$BUILD_SCRATCH/cache" \
           XDG_STATE_HOME="$BUILD_SCRATCH/state"; \
    export PATH="$(mise where node)/bin:$PATH"; \
    npm install -g \
        --allow-scripts=@parcel/watcher,better-sqlite3,node-pty \
        "bb-app@${BB_VERSION}" \
    && mise reshim --force \
    && rm -rf "$BUILD_SCRATCH" "/home/${USERNAME}/.cache" "/home/${USERNAME}/.local"

# A fresh home volume needs developer ownership before bb starts. Heavy tools
# and browsers remain outside home so volume copy-up cannot freeze image files.
RUN mkdir -p /home/${USERNAME}/.bb
COPY --chown=$USERNAME:$USERNAME container/entrypoint.sh /home/${USERNAME}/entrypoint.sh
COPY --chmod=0755 container/bb-backup /usr/local/share/bb/bb-backup

# Only this and below depend on full's toolset. Node and Chromium are inherited
# from worker; bb is installed above this COPY, so full toolset edits fetch none
# of those again. Worker toolset edits do invalidate their full descendants.
COPY --chown=$USERNAME:$USERNAME mise.toml /opt/mise/config.toml
RUN --mount=type=secret,id=github_token,required=false,uid=1000,gid=1000,mode=0400 \
    set -e; \
    if [ -s /run/secrets/github_token ]; then \
      export MISE_GITHUB_TOKEN="$(cat /run/secrets/github_token)"; \
    fi; \
    export npm_config_cache="$BUILD_SCRATCH/npm" \
           XDG_CACHE_HOME="$BUILD_SCRATCH/cache" \
           XDG_STATE_HOME="$BUILD_SCRATCH/state"; \
    mise install; \
    mise reshim --force; \
    rm -rf "$BUILD_SCRATCH" "/home/${USERNAME}/.cache" "/home/${USERNAME}/.local" \
    && install -d -o "$USERNAME" -g "$USERNAME" \
        "/home/${USERNAME}/.cache" "/home/${USERNAME}/.local"

# Worker supplies LANG, PLAYWRIGHT_BROWSERS_PATH and FONTCONFIG_FILE, with the
# same fontconfig override all browser-bearing flavors use. No duplicate copy
# here: make check guards that inherited file against the distro config.
ENV EDITOR=vi \
    VISUAL=vi

USER root

# Mise dispatches on argv[0], so vi/vim must be wrappers, not nvim shim symlinks.
# The toolset declares only nvim's bin; make check rejects shadowing vi/vim shims.
RUN set -e; \
    for name in vi vim; do \
      printf '%s\n' '#!/bin/sh' \
        '# neovim, aliased for the whole container. Not a symlink, see AGENTS.md.' \
        'exec nvim "$@"' \
        > "/usr/local/bin/$name"; \
      chmod 0755 "/usr/local/bin/$name"; \
    done; \
    ln -s /usr/local/share/bb/bb-backup /usr/local/bin/bb-backup

# The hydrator atomically renames its registry as developer, so the directory
# must be writable even though its image-owned inputs are copied below.
RUN install -d -o "$USERNAME" -g "$USERNAME" /usr/local/share/bb
USER $USERNAME

# Managed home sources sit last. Existing volume copies update by hash on
# startup; edited copies stay untouched. Seed new volumes at build time too.
COPY --chown=$USERNAME:$USERNAME container/agents.md container/rc-bash.sh \
    container/rc-zsh.sh container/managed.tsv container/managed-prev.tsv \
    container/hydrate-home.sh /usr/local/share/bb/
RUN bash /usr/local/share/bb/hydrate-home.sh stamp \
    && HOME=/home/${USERNAME} bash /usr/local/share/bb/hydrate-home.sh install

# Override worker's sleep command with the signal-forwarding server entrypoint.
CMD ["bash", "/home/developer/entrypoint.sh"]
LABEL sh.bb.flavor="full"
