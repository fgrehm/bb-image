#!/bin/sh
# Backup and trace archival for the container: backup writes the persistent
# state to a zstd-compressed tar archive with an integrity check on the
# result, and traces mirrors agent session traces and logs with rsync. Both
# are for a caller (a host systemd timer, a compose sidecar cron, or a human)
# to schedule, without anything backup-shaped living in the home volume.
# Scheduling lives outside this image by design (rootless, no boot-time
# service shipped by the project); this script is only the archiving itself.
#
# Usage:
#   bb-backup backup --output DIR [--sqlite PATH]... [--keep N] SRC [SRC...]
#   bb-backup state --output DIR [--include PATH]... [--include-secrets]
#       [--age-recipient RECIPIENT] [--keep N]
#   bb-backup traces --output DIR [--include PATH]... [--flatten]
#   bb-backup verify FILE
#
# The first argument is the subcommand, and there is no default: a bare
# invocation prints usage rather than assuming a strategy. backup is the full
# recovery archive; traces is the additive rsync mirror; verify re-runs the
# integrity check an archive got at write time.
#
# Examples, with the volume and mount names the README's make run uses. The
# output directories are host-side and never inside the home volume: a backup
# that lives on the volume it protects dies with it.
#
#   # Recovery archive of the whole home, live db snapshotted, 7 kept.
#   # bb-home is the named volume; /var/backups/bb is a host directory.
#   bb-backup backup --output /backups/bb \
#       --sqlite /home/developer/.bb/bb.db --keep 7 /home/developer
#
#   # Daily traces mirror, path-preserving, one directory per machine.
#   bb-backup traces --output /backups/bb/traces
#
#   # Merged shape, for a synced remote that wants one directory per tool
#   # rather than one per machine:
#   bb-backup traces --output /traces/pi --flatten
#
# backup:
# --output DIR   destination for backup-<timestamp>.tar.zst (created if missing)
# --sqlite PATH  a live SQLite database: snapshotted with `sqlite3 .backup` into
#                a staging tree at the same path it will have inside the
#                archive, so the archive carries a consistent copy instead of a
#                mid-write page mix. Use for ~/.bb/bb.db and any other live db.
#                Opted into per database; without it, the sources are copied
#                as-is.
# --keep N       keep only the N newest archives in the output directory
#                (default 0: prune nothing)
#
# state:
# --output DIR       destination directory for the final archive (created if missing)
# --include PATH     additional file or directory to archive; repeatable
# --include-secrets  opt in to all plugin secrets/ directories
# --age-recipient RECIPIENT age-encrypt the verified archive to this public recipient;
#                    only ciphertext is written to the output directory
# --keep N           keep only the N newest state archives (default 0)
# --sqlite PATH      additionally snapshot a named live SQLite database
#
# traces:
# --output DIR   the mirror's root (created if missing)
# --include PATH an extra path to include, alongside the defaults. Not
#                mandatory: the defaults below the image cover the agent CLIs
#                it ships, and BB_BACKUP_TRACES_INCLUDES (colon-separated,
#                like PATH) bakes a deployment's extra locations into the
#                environment, so a compose file can carry the convention
#                without flags. Explicit --include paths must exist; missing
#                defaults and env entries are skipped silently.
# --flatten      copy entries by name, merging every source into the target,
#                instead of the default full-path layout. Matches a manual
#                `rsync -av src/* dest/` flow; two sources holding the same
#                path relative to their include then overwrite each other,
#                still additively (last write wins, nothing removed).
#
# verify:
# re-runs the integrity check an archive got at write time; zero means intact.
# Useful for restore flows and for timers that health-check old archives.
#
# traces archives agent session traces and logs (pi sessions, bb logs, the pi
# bridge, pi-extras sessions, claude and codex state by default; --include adds more) with rsync,
# into the output directory itself, and is strictly additive: it never prunes,
# never deletes, and each run copies only the files modified since the previous
# run, tracked by a marker file in the output directory. A file deleted from
# the source stays in the mirror and in every earlier copy, since no run ever
# removes anything, so the output directory accumulates every trace the CLIs
# ever wrote. Unlike the backup mode it is about state, not recovery: restore
# is not its job, and it runs independently of bb.
set -eu
umask 077

usage() {
	echo "usage: bb-backup backup --output DIR [--sqlite PATH]... [--keep N] SRC [SRC...]" >&2
	echo "       bb-backup state --output DIR [--include PATH]... [--include-secrets] [--age-recipient RECIPIENT] [--keep N]" >&2
	echo "       bb-backup traces --output DIR [--include PATH]... [--flatten]" >&2
	echo "       bb-backup verify FILE" >&2
	exit 2
}

mode=
arg=
keep=0
sqlite_files=
sources=
trace_includes=
flatten=0
state_profile=0
include_secrets=0
age_recipient=

# The subcommand is the first argument and is required: there is deliberately
# no default backup strategy for a bare invocation.
[ $# -ge 1 ] || usage
case "$1" in
backup | state | traces | verify)
	mode="$1"
	shift
	;;
*)
	usage
	;;
esac

while [ $# -gt 0 ]; do
	case "$1" in
	--output)
		[ $# -ge 2 ] || usage
		[ "$mode" = verify ] || arg="$2"
		shift 2
		;;
	--sqlite)
		[ $# -ge 2 ] || usage
		[ -f "$2" ] || {
			echo "bb-backup: no such database: $2" >&2
			exit 1
		}
		sqlite_files="$sqlite_files $2"
		shift 2
		;;
	--include)
		[ $# -ge 2 ] || usage
		[ "$mode" = traces ] || [ "$mode" = state ] || usage
		trace_includes="$trace_includes $2"
		shift 2
		;;
	--include-secrets)
		[ "$mode" = state ] || usage
		include_secrets=1
		shift
		;;
	--age-recipient)
		[ "$mode" = state ] && [ $# -ge 2 ] || usage
		[ "$2" != '' ] || usage
		age_recipient="$2"
		shift 2
		;;
	--flatten)
		[ "$mode" = traces ] || usage
		flatten=1
		shift
		;;
	--keep)
		[ $# -ge 2 ] || usage
		case "$2" in
		'' | *[!0-9]*) usage ;;
		esac
		keep="$2"
		shift 2
		;;
	--)
		shift
		while [ $# -gt 0 ]; do
			sources="$sources $1"
			shift
		done
		break
		;;
	-*)
		usage
		;;
	*)
		if [ "$mode" = verify ]; then
			arg="$1"
		else
			sources="$sources $1"
		fi
		shift
		;;
	esac
done

verify_one() {
	# Two passes over the archive: zstd checks its own framing and checksums,
	# then tar reads every member through the whole decompressed payload. A
	# truncated file fails in both, a corrupted middle fails in the second.
	zstd -q -t -- "$1"
	tar -tf "$1" >/dev/null
}

if [ "$mode" = verify ]; then
	[ "$arg" != '' ] || usage
	[ -f "$arg" ] || {
		echo "bb-backup: no such archive: $arg" >&2
		exit 1
	}
	verify_one "$arg"
	echo "bb-backup: archive intact: $arg"
	exit 0
fi

if [ "$mode" = state ]; then
	state_profile=1
	[ "$arg" != '' ] || usage
	[ "$sources" = '' ] || usage
	output="$arg"
	if [ "$age_recipient" != '' ] && ! command -v age >/dev/null 2>&1; then
		echo 'bb-backup: age is required for --age-recipient' >&2
		exit 1
	fi
	# The state profile is intentionally bounded to bb-owned state plus the
	# documented pi trace roots. Credentials and machine-wide home state are
	# not inferred; plugin secrets require explicit opt-in.
	for p in "$HOME/.bb/bb.db" "$HOME/.bb/logs" "$HOME/.bb/pi-bridge-sessions" "$HOME/.bb/pi-extras-sessions" "$HOME/.bb/thread-storage" "$HOME/.pi/agent/sessions"; do
		[ -e "$p" ] && sources="$sources $p"
	done
	plugin_root="$HOME/.bb/plugins"
	if [ -d "$plugin_root" ]; then
		for plugin in "$plugin_root"/*; do
			[ -d "$plugin" ] || continue
			case "$(basename -- "$plugin")" in
			cache | git | npm | runtime | node_modules | toolchain-*) continue ;;
			esac
			# Include per-plugin data files and non-managed directories, but
			# never source/install trees or caches.
			for p in "$plugin"/*; do
				[ -e "$p" ] || continue
				case "$(basename -- "$p")" in
				secrets)
					[ "$include_secrets" = 1 ] || continue
					;;
				node_modules | runtime | cache | dist | build | src | source | install | installs) continue ;;
				esac
				sources="$sources $p"
			done
		done
		# Find SQLite databases under selected plugin state, excluding managed
		# code/cache trees. Secrets are scanned only with explicit opt-in.
		if [ "$include_secrets" = 1 ]; then
			discovered_dbs=$(find "$plugin_root" -type d \( -path "$plugin_root/git" -o -path "$plugin_root/npm" -o -name 'toolchain-*' -o -name node_modules -o -name runtime -o -name cache -o -name dist -o -name build -o -name src -o -name source -o -name install -o -name installs \) -prune -o -type f \( -name '*.db' -o -name '*.sqlite' -o -name '*.sqlite3' \) -print)
		else
			discovered_dbs=$(find "$plugin_root" -type d \( -path "$plugin_root/git" -o -path "$plugin_root/npm" -o -name 'toolchain-*' -o -name secrets -o -name node_modules -o -name runtime -o -name cache -o -name dist -o -name build -o -name src -o -name source -o -name install -o -name installs \) -prune -o -type f \( -name '*.db' -o -name '*.sqlite' -o -name '*.sqlite3' \) -print)
		fi
		sqlite_files="$sqlite_files $discovered_dbs"
	fi
	for p in $trace_includes; do
		[ -e "$p" ] || {
			echo "bb-backup: no such state path: $p" >&2
			exit 1
		}
		sources="$sources $p"
	done
	[ -f "$HOME/.bb/bb.db" ] && sqlite_files="$sqlite_files $HOME/.bb/bb.db"
	if [ "$sources" = '' ] && [ "$sqlite_files" = '' ]; then
		echo 'bb-backup: state: no bb state found, nothing to back up'
		exit 0
	fi
	# The generic source list includes plugin database originals. Their
	# snapshots are appended at the same paths by the existing archive path.
fi

if [ "$mode" = traces ]; then
	[ "$arg" != '' ] || usage
	output="$arg"
	[ ! -e "$output" ] || [ -d "$output" ] || {
		echo "bb-backup: output exists and is not a directory: $output" >&2
		exit 1
	}

	# The default set is the trace and log state of the agent CLIs this image
	# ships, relative to $HOME. BB_BACKUP_TRACES_INCLUDES (colon-separated,
	# like PATH) adds deployment-specific locations from the environment, so a
	# compose file or timer can carry the convention without flags. --include
	# adds paths on top of both, and is the only layer that must exist: missing
	# defaults and env entries are skipped without complaint, since not every
	# CLI or mount is in use everywhere.
	trace_paths=
	for p in .pi/agent/sessions .bb/logs .bb/pi-bridge-sessions .bb/pi-extras-sessions .claude .codex; do
		[ -d "$HOME/$p" ] && trace_paths="$trace_paths $HOME/$p"
	done
	oldIFS=$IFS
	IFS=:
	for p in ${BB_BACKUP_TRACES_INCLUDES:-}; do
		[ -e "$p" ] && trace_paths="$trace_paths $p"
	done
	IFS=$oldIFS
	for p in $trace_includes; do
		[ -e "$p" ] || {
			echo "bb-backup: no such trace path: $p" >&2
			exit 1
		}
		trace_paths="$trace_paths $p"
	done
	[ "$trace_paths" != '' ] || {
		echo 'bb-backup: traces: nothing to archive (no default or included paths exist)' >&2
		exit 1
	}

	marker="$output/.traces-last"
	since='1970-01-01 00:00:00'
	[ ! -f "$marker" ] || since="$(cat -- "$marker")"
	mkdir -p -- "$output"

	# Only files newer than the marker are candidates; the find is what makes
	# the run incremental rather than a full re-copy, and an empty run leaves
	# the marker alone, so nothing is lost or duplicated.
	# shellcheck disable=SC2086
	find $trace_paths -type f -newermt "$since" >"$output/.files-from.$$"
	[ -s "$output/.files-from.$$" ] || {
		rm -f -- "$output/.files-from.$$"
		echo 'bb-backup: traces: nothing new since the last run'
		exit 0
	}

	# rsync into the output directory itself, no tarball. No --delete anywhere:
	# an older copy of a file a source has since removed stays, so the mirror
	# only ever grows. rsync's exit status is the check; a failure leaves the
	# marker unmoved and the next run sees the same files as new.
	status=0
	if [ "$flatten" = 0 ]; then
		# Default: -R with --files-from replays each absolute path minus its
		# leading slash, so the mirror has the same layout as the sources.
		rsync -aR --files-from="$output/.files-from.$$" / "$output" || status=$?
	else
		# Flatten: per source, entries made relative to that source, so every
		# source merges into the target like a manual `rsync -av src/* dest/`.
		# Two sources holding the same relative path overwrite each other, but
		# nothing is ever removed.
		for src in $trace_paths; do
			if [ -f "$src" ] && [ ! -d "$src" ]; then
				rsync -a -- "$src" "$output/" || status=$?
				continue
			fi
			one="$output/.files-from.$$.$(printf '%s' "$src" | md5sum | cut -d' ' -f1)"
			# Entries relative to the source, and -R recreates exactly that
			# structure in the target: every source merges into the target root,
			# like a manual `rsync -av src/* dest/`.
			find "$src" -type f -newermt "$since" | sed "s|^$src/||" >"$one"
			[ -s "$one" ] || {
				rm -f -- "$one"
				continue
			}
			rsync -aR --files-from="$one" "$src/" "$output/" || status=$?
			rm -f -- "$one"
		done
	fi
	rm -f -- "$output/.files-from.$$"
	[ "$status" = 0 ] || exit "$status"
	date '+%Y-%m-%d %H:%M:%S.%N' >"$marker.tmp.$$"
	mv -- "$marker.tmp.$$" "$marker"
	echo "bb-backup: traces: mirrored into $output"
	exit 0
fi

if [ "$arg" = '' ] || { [ "$sources" = '' ] && [ "$sqlite_files" = '' ]; }; then
	usage
fi
output="$arg"
[ ! -e "$output" ] || [ -d "$output" ] || {
	echo "bb-backup: output exists and is not a directory: $output" >&2
	exit 1
}

# The staging tree mirrors the archive layout for the sqlite snapshots: a
# database like /home/bb/.bb/bb.db is staged at home/bb/.bb/bb.db, exactly
# where tar will place it and where unpacking over a fresh home will find it.
staging="$(mktemp -d "${TMPDIR:-/tmp}/bb-backup.XXXXXX")"
trap 'rm -rf -- "$staging"' EXIT HUP INT TERM

for db in $sqlite_files; do
	target="$staging/$(dirname -- "$db")"
	mkdir -p -- "$target"
	sqlite3 -- "$db" ".backup '$target/$(basename -- "$db")'"
done

name="backup-$(date +%Y%m%d-%H%M%S).tar.zst"
tmp="$staging/$name"
raw="$tmp.tar"

# The plain tar is written to the staging directory first: appending the
# snapshots is only possible on an uncompressed archive, and the final zstd
# stream must be written once, then verified, then named. Nothing partial ever
# appears in the output directory.
# Word splitting on $sources and $sqlite_files is deliberate: they are
# whitespace-separated path lists from the command line, and paths with
# spaces in them are not supported.
# shellcheck disable=SC2086
if [ "$state_profile" = 1 ]; then
	if [ "$include_secrets" = 1 ]; then
		tar -cf "$raw" --exclude='*/.bb/plugins/git' --exclude='*/.bb/plugins/npm' --exclude='*/node_modules' --exclude='*/runtime' --exclude='*/cache' --exclude='*/dist' --exclude='*/build' --exclude='*/src' --exclude='*/source' --exclude='*/install' --exclude='*/installs' --exclude='*/toolchain-*' --exclude='*-wal' --exclude='*-shm' $sources
	else
		tar -cf "$raw" --exclude='*/secrets' --exclude='*/.bb/plugins/git' --exclude='*/.bb/plugins/npm' --exclude='*/node_modules' --exclude='*/runtime' --exclude='*/cache' --exclude='*/dist' --exclude='*/build' --exclude='*/src' --exclude='*/source' --exclude='*/install' --exclude='*/installs' --exclude='*/toolchain-*' --exclude='*-wal' --exclude='*-shm' $sources
	fi
else
	tar -cf "$raw" $sources
fi
for db in $sqlite_files; do
	# The staged snapshot path is stripped of its leading slash and passed relative,
	# so no separator is needed.
	tar -C "$staging" -rf "$raw" "$(printf '%s' "$db" | sed 's|^/||')"
done
zstd -q -9 -o "$tmp" -- "$raw"
rm -f -- "$raw"

verify_one "$tmp"

mkdir -p -- "$output"
chmod 0700 -- "$output"
if [ "$state_profile" = 1 ] && [ "$age_recipient" != '' ]; then
	ciphertext="$staging/$name.age"
	age --encrypt --recipient "$age_recipient" --output "$ciphertext" "$tmp"
	chmod 0600 -- "$ciphertext"
	mv -- "$ciphertext" "$output/$name.age"
	final="$output/$name.age"
else
	mv -- "$tmp" "$output/$name"
	final="$output/$name"
fi
echo "bb-backup: wrote $final"

if [ "$keep" -gt 0 ]; then
	# Newest first; everything past the Nth goes. Only this script's own
	# archives are considered, so other files in the directory are safe.
	# shellcheck disable=SC2012,SC2010
	for victim in $(
		ls -1t -- "$output" | grep -E '^backup-[0-9]{8}-[0-9]{6}\.tar\.zst(\.age)?$' |
			tail -n +"$((keep + 1))"
	); do
		rm -f -- "$output/$victim"
	done
fi
