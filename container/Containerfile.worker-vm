# worker-vm: the same BB-free environment with systemd for manually enrolled
# machine services. PAM and the user bus let linger start developer's user
# manager at boot; the installer can then create its unprivileged service.
# Passwordless sudo is inherited for guest administration, not enrollment.
# None of this enrolls the worker.
# ---------------------------------------------------------------------------

ARG BASE_IMAGE=localhost/bb-stage-worker:dev
FROM ${BASE_IMAGE} AS worker-vm

USER root
COPY container/packages-vm-systemd.txt /tmp/packages-vm-systemd.txt
COPY container/packages-vm-podman.txt /tmp/packages-vm-podman.txt
RUN set -e; \
    apt-get update \
    && cat /tmp/packages-vm-systemd.txt /tmp/packages-vm-podman.txt \
        | grep -vE '^(\s*(#.*)?)$' \
        | xargs apt-get install -y --no-install-recommends \
    && systemctl disable podman.socket netavark-dhcp-proxy.socket netavark-dhcp-proxy.service \
    && sed -i -E 's/^hosts:.*/hosts: files myhostname dns/' /etc/nsswitch.conf \
    && rm -rf /var/lib/apt/lists/* /tmp/packages-vm-systemd.txt /tmp/packages-vm-podman.txt \
    && install -d /var/lib/systemd/linger \
    && touch /var/lib/systemd/linger/developer \
    && install -d /etc/systemd/system/user@1000.service.d \
    && rm -f /etc/machine-id /var/lib/dbus/machine-id \
    && : > /etc/machine-id

COPY --chmod=0644 container/user-manager-mise.conf /etc/systemd/system/user@1000.service.d/mise.conf
COPY --chmod=0644 container/containers-vm-podman.conf /etc/containers/containers.conf
COPY --chmod=0644 container/podman-tun.conf /etc/tmpfiles.d/bb-podman-tun.conf

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
LABEL sh.bb.flavor="worker-vm"
