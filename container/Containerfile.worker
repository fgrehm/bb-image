# ---------------------------------------------------------------------------
# worker: a BB-free execution environment for manual machine enrollment.
# No server, host daemon, credentials, or startup-time enrollment is baked in.
# Node and the lazy agent CLIs are enough for the installer to fetch the exact
# host-only bb-app build from whichever server the operator chooses. Playwright
# and Chromium are inherited from the shared browser layer. Keep this
# separate from slim: inheriting slim and uninstalling bb would retain its
# bytes in a lower image layer and shadow the installer's private copy.
#
# The container stays alive so the operator can exec the enrollment command.
# The installer starts an unsupervised daemon in a container without systemd;
# restarting the container requires an explicit restart of that daemon until
# a separately validated supervision policy is in place.
# ---------------------------------------------------------------------------

ARG BASE_IMAGE=localhost/bb-stage-browser:dev
FROM ${BASE_IMAGE} AS worker

ARG USERNAME
ARG BUILD_SCRATCH

COPY --chown=$USERNAME:$USERNAME container/mise-slim.toml /opt/mise/config.toml
RUN --mount=type=secret,id=github_token,required=false,uid=1000,gid=1000,mode=0400 \
    set -e; \
    if [ -s /run/secrets/github_token ]; then \
      export MISE_GITHUB_TOKEN="$(cat /run/secrets/github_token)"; \
    fi; \
    export npm_config_cache="$BUILD_SCRATCH/npm" \
           XDG_CACHE_HOME="$BUILD_SCRATCH/cache" \
           XDG_STATE_HOME="$BUILD_SCRATCH/state"; \
    mise install; \
    mise reshim --force; \
    rm -rf "$BUILD_SCRATCH" "/home/${USERNAME}/.cache" "/home/${USERNAME}/.local" \
    && install -d -o "$USERNAME" -g "$USERNAME" \
        "/home/${USERNAME}/.cache" "/home/${USERNAME}/.local"

CMD ["sleep", "infinity"]
LABEL sh.bb.flavor="worker"
