# ---------------------------------------------------------------------------
# worker: foundation's Node and sudo, plus Playwright/Chromium and lazy agent
# CLIs. No BB server, host daemon, credentials or enrollment is baked in.
# Full inherits this browser-bearing base; slim stays browser-free.
#
# The container stays alive for manual enrollment. Its detached daemon does
# not recover after container restart without a separate supervision policy.
# ---------------------------------------------------------------------------

ARG BASE_IMAGE=localhost/bb-stage-foundation:dev
FROM ${BASE_IMAGE} AS worker

ARG USERNAME
ARG BUILD_SCRATCH
ARG PLAYWRIGHT_VERSION

# Install the expensive browser layers before the mutable worker toolset COPY.
# The bootstrap Node config is still active here, with no runtime cache overrides.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN --mount=type=secret,id=github_token,required=false,uid=1000,gid=1000,mode=0400 \
    set -e; \
    if [ -s /run/secrets/github_token ]; then \
      export MISE_GITHUB_TOKEN="$(cat /run/secrets/github_token)"; \
    fi; \
    export npm_config_cache="$BUILD_SCRATCH/npm" \
           XDG_CACHE_HOME="$BUILD_SCRATCH/cache" \
           XDG_STATE_HOME="$BUILD_SCRATCH/state"; \
    npm install -g "playwright@${PLAYWRIGHT_VERSION}" \
    && mise reshim --force \
    && rm -rf "$BUILD_SCRATCH" "/home/${USERNAME}/.cache" "/home/${USERNAME}/.local"

USER root
RUN playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* \
    && chown -R "$USERNAME:$USERNAME" /opt/ms-playwright
USER $USERNAME

# Shared with full through inheritance. A caller replacing Playwright's launch
# environment must carry FONTCONFIG_FILE across; make check guards distro drift.
COPY container/fonts.conf /usr/local/share/bb/fonts.conf
ENV FONTCONFIG_FILE=/usr/local/share/bb/fonts.conf

COPY --chown=$USERNAME:$USERNAME container/mise-slim.toml /opt/mise/config.toml
RUN --mount=type=secret,id=github_token,required=false,uid=1000,gid=1000,mode=0400 \
    set -e; \
    if [ -s /run/secrets/github_token ]; then \
      export MISE_GITHUB_TOKEN="$(cat /run/secrets/github_token)"; \
    fi; \
    export npm_config_cache="$BUILD_SCRATCH/npm" \
           XDG_CACHE_HOME="$BUILD_SCRATCH/cache" \
           XDG_STATE_HOME="$BUILD_SCRATCH/state"; \
    mise install; \
    mise reshim --force; \
    rm -rf "$BUILD_SCRATCH" "/home/${USERNAME}/.cache" "/home/${USERNAME}/.local" \
    && install -d -o "$USERNAME" -g "$USERNAME" \
        "/home/${USERNAME}/.cache" "/home/${USERNAME}/.local"

ENV LANG=C.UTF-8
CMD ["sleep", "infinity"]
LABEL sh.bb.flavor="worker"
