# Pinned to the multi-arch OCI index digest for reproducible builds.
# Bump with: podman images --digests | grep debian
#
# Build arguments live once here, before the first FROM, so the version pins
# have a single home that the Makefile and check fragments can read with sed.
# Each stage redeclares the ones it uses, bare, which is also how a
# --build-arg invoked on the whole build reaches every stage.
#
# Scoped to the build rather than ENV, so it does not leak into the final image.
ARG DEBIAN_FRONTEND=noninteractive
ARG USERNAME=developer
ARG USER_UID=1000
ARG USER_GID=1000
ARG MISE_VERSION=2026.9.5
ARG NODE_VERSION=24.21.0
ARG BB_VERSION=0.43.3
ARG PLAYWRIGHT_VERSION=1.63.0
#
# A scratch dir every downloading RUN points its caches at and deletes before it
# ends, ARG rather than ENV so none of it lands in the runtime environment; the
# details are documented at first use in the full stage.
ARG BUILD_SCRATCH=/tmp/build-scratch

# ---------------------------------------------------------------------------
# foundation: everything every variant in this family starts from. The distro
# pinned above, the unprivileged user, mise with its data outside home, and the
# packages every image carries (see container/packages-foundation.txt). It has
# no packaged bb, no server command and no variant-specific toolset; it is
# internal and never published. The variants branch off it below.
# ---------------------------------------------------------------------------

FROM docker.io/library/debian@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132 AS foundation

ARG DEBIAN_FRONTEND
ARG USERNAME
ARG USER_UID
ARG USER_GID
ARG MISE_VERSION
ARG NODE_VERSION

# The package list is a file so the inventory is diffable and reviewable on its
# own; the file carries the rationale comments. It is copied into /tmp and
# deleted in the same RUN, so nothing survives into a layer.
COPY container/packages-foundation.txt /tmp/packages-foundation.txt
RUN apt-get update \
    && grep -vE '^(\s*(#.*)?)$' /tmp/packages-foundation.txt \
       | xargs apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* /tmp/packages-foundation.txt

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash $USERNAME

# mise, its toolchains, and the toolset all live outside the user's home.
#
# Home is volume-backed at runtime, and a named volume is seeded from the image
# exactly once. Anything the image owns under home would therefore freeze at
# first boot and shadow later image updates. Keeping the toolchain out of home
# means the baked tools stay in step with the image instead of drifting inside
# a volume, and it keeps the first-boot copy into that volume small.

# The installer verifies the release checksum. Pinning MISE_VERSION keeps the
# build reproducible and selects the checksum from that release's SHASUMS256.txt.
RUN curl -fsSL https://mise.run \
    | MISE_INSTALL_PATH=/usr/local/bin/mise MISE_VERSION="v${MISE_VERSION}" sh

# MISE_DATA_DIR holds installed toolchains and the shim farm, and
# MISE_GLOBAL_CONFIG_FILE points the toolset outside home. Both are deliberately
# not volume-backed: what the image bakes stays current, and anything installed at
# runtime is per-container. /usr/local/bin, where the binary went, is on the
# default PATH.
#
# The toolset has to be the *global* config rather than the system config at
# /etc/mise, even though the latter reads just as well. mise only creates
# bootstrap shims for tools it picks up from the user or project scope, so the
# same file under /etc/mise yields shims for installed tools only: node and bb
# get one, every lazy tool silently does not, and first-use installation stops
# working because there is no shim to invoke. It is writable by the user so
# `mise use -g` works, though such changes live and die with the container.
ENV MISE_DATA_DIR=/opt/mise
ENV MISE_GLOBAL_CONFIG_FILE=/opt/mise/config.toml
ENV PATH="/opt/mise/shims:$PATH"

# Shared runtime cache paths, available to every variant and every exec context.
# The default-home ENVs are complemented by `${HOME}`-relative [env] entries in
# each variant's mise config so mise-managed commands remain correct when a
# derived image renames the user. Such images should redeclare these ENVs too if
# raw execs need renamed-home paths.
ENV TMPDIR=/tmp
ENV npm_config_cache=/home/developer/.cache/npm
ENV pnpm_config_store_dir=/home/developer/.cache/pnpm-store
ENV npm_config_store_dir=/home/developer/.cache/pnpm-store
ENV CARGO_HOME=/home/developer/.cargo
ENV GOPATH=/home/developer/go
ENV GOMODCACHE=/home/developer/go/pkg/mod
ENV GOCACHE=/home/developer/.cache/go-build
ENV UV_CACHE_DIR=/home/developer/.cache/uv

# No cache location is pinned here, on purpose. A cache is the one thing a volume is
# the right home for, so with nothing set, runtime npm writes to ~/.npm and mise to
# ~/.cache/mise, both inside the home volume, where they survive a recreate. Pinning
# them to /opt made every runtime cache per-container and baked 165MB of build-time
# cache into the image to no purpose.
#
# Build-time caches are the harder half, because a layer is a stack and a delete in a
# later layer is only a whiteout: bytes written in one layer still count toward the
# size after a later layer removes them. Verified with a throwaway 200MB layer, where
# the same delete in a separate RUN left the image at 277MB rather than 77MB. So every
# RUN that downloads points these at $BUILD_SCRATCH and removes it before the RUN
# ends, and the bytes never reach a layer. ARG rather than ENV so none of it lands in
# the runtime environment.

# A bootstrap config holding only node. The real toolset is copied in further
# down in the full stage, after the expensive layers, so editing it does not
# invalidate them; the variants that branch off foundation replace this file in
# their own way. node is installed from an explicit version rather than read
# out of a toolset file, so the version is named twice, once at the top and
# once in mise.toml, because a layer cannot both install node and depend on the
# file that declares it. check.sh (make check) fails a release if the two drift
# apart.
RUN mkdir -p /opt/mise \
    && printf '[tools]\nnode = "%s"\n' "${NODE_VERSION}" > /opt/mise/config.toml \
    && chown -R $USERNAME:$USERNAME /opt/mise

# Debian's /etc/profile resets PATH outright, which drops the mise shims, so a login
# shell (`bash -l`, ssh, or anything bb spawns through one) loses every lazy tool and
# they all become "command not found". Image-owned, so unlike ~/.bashrc this is not
# frozen into the home volume and can still be fixed after a volume exists.
RUN set -e; \
    printf '%s\n' \
      '# Debian /etc/profile resets PATH, which drops the mise shims. Put them back.' \
      'case ":$PATH:" in' \
      '  *:/opt/mise/shims:*) ;;' \
      '  *) PATH="/opt/mise/shims:$PATH" ;;' \
      'esac' \
      'export PATH' \
      > /etc/profile.d/mise-shims.sh \
    && chmod 0644 /etc/profile.d/mise-shims.sh

USER $USERNAME

# bb hosts many projects and resolves them by path, so home is the sane default
# rather than a single mount point. Mount a tree under it (see the Makefile).
WORKDIR /home/${USERNAME}

# ---------------------------------------------------------------------------
# full: the batteries-included image, the same artifact the unsuffixed tags
# have always meant. Node, packaged bb, Playwright's Chromium, the build
# toolchain, dev tools, backup tooling, and document/image support on top of
# what foundation carries (container/packages-full.txt).
# ---------------------------------------------------------------------------

FROM foundation AS full

ARG DEBIAN_FRONTEND
ARG USERNAME
ARG BUILD_SCRATCH
ARG BB_VERSION
ARG PLAYWRIGHT_VERSION

# foundation left off as the unprivileged user; the package tier full adds is
# root's to install, and the stage steps back down before any of the layers
# below run as developer.
USER root
COPY container/packages-full.txt /tmp/packages-full.txt
RUN apt-get update \
    && grep -vE '^(\s*(#.*)?)$' /tmp/packages-full.txt \
       | xargs apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* /tmp/packages-full.txt
USER $USERNAME

# GitHub token, optional. mise resolves versions and verifies artifact attestations
# through api.github.com, which serves 60 requests per hour unauthenticated against 1000
# with a token, so builds fail intermittently without one.
#
# The token arrives as a BuildKit secret and lives only for the duration of a RUN. It is
# never a build arg and never an ENV, because both persist in image metadata, and it is
# never echoed, because podman does not redact secrets from build output the way BuildKit
# does. The file form is deliberate: reading it with `cat` and matching it with `grep -f`
# keeps the value out of every process argument list. required=false keeps an ordinary
# local build, with no token at all, working.
#
# uid, gid and mode are load-bearing here (or rather, they matter). The toolset RUNs run as
# the unprivileged developer, and a secret mounted with default permissions is unreadable
# to it. `cat` then fails inside a command substitution, which does not trip `set -e`, so
# the build continues with an empty token and mise quietly stays unauthenticated. That
# failure mode looks exactly like the rate limiting it was meant to fix. Keep 1000 in step
# with USER_UID.
#
# The token does not reach the image: the token leak scan in build/check.sh runs
# against the built image at verification time, before a release is pushed.

# node is the runtime the image is built around. The version was declared at the
# top and baked into the bootstrap config by foundation; this RUN installs it.
RUN --mount=type=secret,id=github_token,required=false,uid=1000,gid=1000,mode=0400 \
    if [ -s /run/secrets/github_token ]; then \
      export MISE_GITHUB_TOKEN="$(cat /run/secrets/github_token)"; \
    fi; \
    export npm_config_cache="$BUILD_SCRATCH/npm" \
           XDG_CACHE_HOME="$BUILD_SCRATCH/cache" \
           XDG_STATE_HOME="$BUILD_SCRATCH/state"; \
    mise install \
    && mise reshim --force \
    && rm -rf "$BUILD_SCRATCH"

# bb is installed globally into mise's node install, so bumping the node version
# above means reinstalling it. npm gates native-addon install scripts, so the
# three bb depends on have to be allowed explicitly or bb will not work:
# @parcel/watcher, better-sqlite3, and node-pty are compiled or fetched here.
RUN --mount=type=secret,id=github_token,required=false,uid=1000,gid=1000,mode=0400 \
    if [ -s /run/secrets/github_token ]; then \
      export MISE_GITHUB_TOKEN="$(cat /run/secrets/github_token)"; \
    fi; \
    export npm_config_cache="$BUILD_SCRATCH/npm" \
           XDG_CACHE_HOME="$BUILD_SCRATCH/cache" \
           XDG_STATE_HOME="$BUILD_SCRATCH/state"; \
    npm install -g \
        --allow-scripts=@parcel/watcher,better-sqlite3,node-pty \
        "bb-app@${BB_VERSION}" \
    && mise reshim --force \
    && rm -rf "$BUILD_SCRATCH"

# Playwright's Chromium, ready to use without a first-run download. Browsers go to
# /opt/ms-playwright, outside home, for the same reason as the toolchain: a
# volume-backed home would otherwise copy ~170MB into the volume at first boot.
#
# It is an npm global rather than a mise tool so that the browser download sits in
# a layer toolset edits do not invalidate, and because `install --with-deps` needs
# root, which the toolset layers deliberately are not.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN --mount=type=secret,id=github_token,required=false,uid=1000,gid=1000,mode=0400 \
    if [ -s /run/secrets/github_token ]; then \
      export MISE_GITHUB_TOKEN="$(cat /run/secrets/github_token)"; \
    fi; \
    export npm_config_cache="$BUILD_SCRATCH/npm" \
           XDG_CACHE_HOME="$BUILD_SCRATCH/cache" \
           XDG_STATE_HOME="$BUILD_SCRATCH/state"; \
    npm install -g "playwright@${PLAYWRIGHT_VERSION}" \
    && mise reshim --force \
    && rm -rf "$BUILD_SCRATCH"

USER root
RUN playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* \
    && chown -R $USERNAME:$USERNAME /opt/ms-playwright
USER $USERNAME

# ~/.bb holds server state. It is created in the image so the copy-up into a home
# volume carries the right uid/gid: a volume created empty would be root-owned
# and bb could not write to it.
RUN mkdir -p /home/${USERNAME}/.bb

COPY --chown=$USERNAME:$USERNAME container/entrypoint.sh /home/${USERNAME}/entrypoint.sh

# The backup script, image-owned so it stays in step with the image instead
# of freezing inside the home volume. Scheduling stays outside (see README).
COPY --chmod=0755 container/bb-backup /usr/local/share/bb/bb-backup

# ---------------------------------------------------------------------------
# The toolset. Only this and below rebuild when mise.toml changes.
# ---------------------------------------------------------------------------

# Overwrites the bootstrap config written above. Owned by the user so that
# `mise use -g` keeps working.
COPY --chown=$USERNAME:$USERNAME mise.toml /opt/mise/config.toml

# Catch a NODE_VERSION that no longer matches the toolset rather than shipping an
# image whose node is not the one mise reports. Then install the baked tools and
# reconcile the shim farm. This is the layer that downloads the baked dev tools
# (rg, jq, nvim and friends), so a toolset edit re-downloads them. node, bb and
# Playwright's Chromium sit above it and stay cached.
#
# The rm at the end does real work, and it stays last in the RUN. BUILD_SCRATCH
# takes the downloads and mise's sigstore TUF cache out of $HOME and out of the
# layer: home is volume-backed and seeded once, so leftovers there bake into every new
# volume, and a cache committed to a layer stays in the image even after a later layer
# deletes it. The rm has to follow node and bb, because those go through shims and run
# mise again, which recreates the state directory.
RUN --mount=type=secret,id=github_token,required=false,uid=1000,gid=1000,mode=0400 \
    set -e; \
    if [ -s /run/secrets/github_token ]; then \
      export MISE_GITHUB_TOKEN="$(cat /run/secrets/github_token)"; \
    fi; \
    export npm_config_cache="$BUILD_SCRATCH/npm" \
           XDG_CACHE_HOME="$BUILD_SCRATCH/cache" \
           XDG_STATE_HOME="$BUILD_SCRATCH/state"; \
    mise install; \
    mise reshim --force; \
    rm -rf "$BUILD_SCRATCH" "/home/${USERNAME}/.cache" "/home/${USERNAME}/.local" \
    && install -d -o "$USERNAME" -g "$USERNAME" \
        "/home/${USERNAME}/.cache" "/home/${USERNAME}/.local"

# ---------------------------------------------------------------------------
# Locale, editor, the fontconfig override, login-shell PATH, and the neovim alias.
# This block sits last on purpose. An ENV invalidates every layer below it, so
#
# putting LANG up with the other ENVs would force node, bb and Playwright's
# Chromium to rebuild. Nothing above needs these values.
# ---------------------------------------------------------------------------

# Chromium does fontconfig cache bookkeeping before any real work, and a sandboxed
# agent is denied both writes:
#
#   - FcDirCacheWrite probes each cache directory in order and, when the probe
#     fails but the directory exists, calls chmod(dir, 0755). Debian's first
#     cachedir is /var/cache/fontconfig, which is root-owned image content, so
#     every browser launch attempts that chmod. It is also what the agent sees as
#     "Write blocked: /var/cache/fontconfig".
#   - a directory cache that has to be rebuilt is preceded by an unlink of the
#     .uuid marker beside the fonts. Nothing creates those markers in fontconfig
#     2.15 (FcDirCacheCreateUUID is a stub), so this is an unlink of a path that
#     does not exist, reached only when the cache is cold.
#
# fontconfig can add cache directories but never prune one (<reset-dirs/> covers
# <dir> only), so Debian's file cannot be trimmed by including it. fonts.conf next
# to this Containerfile is that file with the system cache directories removed and
# the xdg one kept explicitly, because a config with no <cachedir> at all makes
# fontconfig re-add /var/cache/fontconfig from its compiled-in defaults and warn
# about it.
#
# Chromium bundles its own fontconfig, and Playwright hands its environment to the
# browser, so FONTCONFIG_FILE reaches the Chromium that bb spawns. A caller that
# passes Playwright's launch({ env }) option replaces that environment wholesale
# and has to carry FONTCONFIG_FILE across itself.

COPY container/fonts.conf /usr/local/share/bb/fonts.conf
ENV FONTCONFIG_FILE=/usr/local/share/bb/fonts.conf

# A font package bump that moved the distro file out from under this copy would
# silently drop font directories and alias rules, so the comparison against the
# distro file is a release gate. It lives in container/fontconfig.sh, next to the
# file it guards, and runs under make check: the publish workflow runs make check
# before an image is pushed, and make fonts-regen regenerates this file. Nothing
# verification-shaped lives in this Containerfile; every RUN builds, none assert.

# LANG is unset in the base image and LC_CTYPE lands on POSIX, which shows up as
# encoding trouble in anything that prints non-ASCII. C.UTF-8 needs no locales
# package on Debian 13.
ENV LANG=C.UTF-8
# git reaches for $EDITOR for `git commit` without -m and for `git rebase -i`.
ENV EDITOR=vi
ENV VISUAL=vi

USER root

# neovim as vi and vim, for the whole container. These must be wrapper scripts and
# not symlinks. mise's shims are symlinks to the mise binary and it dispatches on
# the tool name in argv[0], so a shim reached as "vim" is rejected with "vim is not
# a valid shim". `exec nvim` re-enters through the shim under its real name instead.
# mise's neovim declares bins = ["nvim"], so no vim/vi shim exists to shadow these;
# if one ever appeared it would break the alias, and the shim scan running under
# make check catches that before a release ships.
RUN set -e; \
    for name in vi vim; do \
      printf '%s\n' '#!/bin/sh' \
        '# neovim, aliased for the whole container. Not a symlink, see AGENTS.md.' \
        'exec nvim "$@"' \
        > "/usr/local/bin/$name"; \
      chmod 0755 "/usr/local/bin/$name"; \
    done; \
    ln -s /usr/local/share/bb/bb-backup /usr/local/bin/bb-backup

# No verification RUNs anywhere in this file on purpose: every assertion that used
# to live at the tail (writable mise dir, token leak scan, fontconfig drift) now
# runs under make check, in build/check.sh and container/fontconfig.sh, and the
# publish workflow runs make check before an image is pushed. This file only
# builds the image, it never asserts about it.

# The hydration registry is stamped by developer with an atomic rename, so its
# directory, not just the files copied into it, must be developer-owned.
RUN install -d -o "$USERNAME" -g "$USERNAME" /usr/local/share/bb

# Back to the image user for the tail of the build, so the hydration below
# writes both the stamped registry and its home copies as developer.
USER $USERNAME

# Home hydration. bb appends <dataDir>/AGENTS.md to the system prompt of every
# provider-backed thread, so agents.md there is the container-level guidance
# agents get about the mise toolchain; the rc snippets are the mise activation
# blocks for interactive shells. All of these are home-volume content, and a
# named volume is seeded from the image exactly once, so the entrypoint hydrates
# them on every start with hydrate-home.sh against the registry shipped here.
# The copies under /usr/local/share/bb are the pristine sources and the registry
# that vouches for which shipped versions the volume may still carry; home
# copies a user edited are left alone.
#
# This block sits last so that editing a managed source rebuilds only these
# layers. Above the toolset COPY, an AGENTS.md edit would invalidate the mise
# toolset layers and re-download the baked dev tools.
COPY --chown=$USERNAME:$USERNAME container/agents.md container/rc-bash.sh \
    container/rc-zsh.sh container/managed.tsv container/managed-prev.tsv \
    container/hydrate-home.sh /usr/local/share/bb/

# Stamp the registry so its hashes cannot drift from the sources it points at,
# then hydrate the image's home once: a freshly seeded volume is already
# correct, so make hack works on a new volume without waiting for the
# entrypoint.
RUN bash /usr/local/share/bb/hydrate-home.sh stamp \
    && HOME=/home/${USERNAME} bash /usr/local/share/bb/hydrate-home.sh install

# Default to serving bb, with the entrypoint forwarding signals so `podman stop`
# is a clean shutdown. Override with a command to get a shell instead:
#   podman run --rm -it bb:dev /bin/bash

CMD ["bash", "/home/developer/entrypoint.sh"]

# Identity marker: the check harness refuses to run this image's checks as
# another flavor, so a slim build can never pass because it was verified as
# full, and vice versa. sudo stages stamp their own flavor over the one they
# inherit.
LABEL sh.bb.flavor="full"

# ---------------------------------------------------------------------------
# slim: the small extensible bb runtime. Node, packaged bb, lazy pnpm and the
# coding-agent CLIs through mise, the entrypoint, and the hydration machinery.
# Explicitly not here: Chromium and Playwright, the build toolchain, database
# clients, media and document tools, the baked dev tools, the backup tooling,
# and sudo. The node and bb layers are built again in this stage rather than
# shared with full: cache keys follow the parent chain, and full installs its
# package tier between foundation and node, so the instructions cannot be
# identical ones. Editing this block rebuilds only slim's layers.
# ---------------------------------------------------------------------------

FROM foundation AS slim

ARG USERNAME
ARG BUILD_SCRATCH
ARG BB_VERSION

# node, installed from the bootstrap config foundation wrote. Same recipe as the
# full stage; the secret-mount details are documented there.
RUN --mount=type=secret,id=github_token,required=false,uid=1000,gid=1000,mode=0400 \
    if [ -s /run/secrets/github_token ]; then \
      export MISE_GITHUB_TOKEN="$(cat /run/secrets/github_token)"; \
    fi; \
    export npm_config_cache="$BUILD_SCRATCH/npm" \
           XDG_CACHE_HOME="$BUILD_SCRATCH/cache" \
           XDG_STATE_HOME="$BUILD_SCRATCH/state"; \
    mise install \
    && mise reshim --force \
    && rm -rf "$BUILD_SCRATCH"

# bb, with the same npm arguments full uses; native addons are compiled or
# fetched at install time either way.
RUN --mount=type=secret,id=github_token,required=false,uid=1000,gid=1000,mode=0400 \
    if [ -s /run/secrets/github_token ]; then \
      export MISE_GITHUB_TOKEN="$(cat /run/secrets/github_token)"; \
    fi; \
    export npm_config_cache="$BUILD_SCRATCH/npm" \
           XDG_CACHE_HOME="$BUILD_SCRATCH/cache" \
           XDG_STATE_HOME="$BUILD_SCRATCH/state"; \
    npm install -g \
        --allow-scripts=@parcel/watcher,better-sqlite3,node-pty \
        "bb-app@${BB_VERSION}" \
    && mise reshim --force \
    && rm -rf "$BUILD_SCRATCH"

# The slim toolset, overwriting the bootstrap config. Owned by the user so that
# `mise use -g` keeps working.
COPY --chown=$USERNAME:$USERNAME container/mise-slim.toml /opt/mise/config.toml

# Reconcile the shim farm for the slim toolset. Nothing is downloaded here, and
# the rm guard matches the full stage: build residue must not reach $HOME; a
# cache committed to a layer survives a later delete.
RUN --mount=type=secret,id=github_token,required=false,uid=1000,gid=1000,mode=0400 \
    set -e; \
    if [ -s /run/secrets/github_token ]; then \
      export MISE_GITHUB_TOKEN="$(cat /run/secrets/github_token)"; \
    fi; \
    export npm_config_cache="$BUILD_SCRATCH/npm" \
           XDG_CACHE_HOME="$BUILD_SCRATCH/cache" \
           XDG_STATE_HOME="$BUILD_SCRATCH/state"; \
    mise install; \
    mise reshim --force; \
    rm -rf "$BUILD_SCRATCH" "/home/${USERNAME}/.cache" "/home/${USERNAME}/.local" \
    && install -d -o "$USERNAME" -g "$USERNAME" \
        "/home/${USERNAME}/.cache" "/home/${USERNAME}/.local"

# No browsers in slim, so no fontconfig override; the fontconfig story lives in
# the full image. LANG still matters here: agents print non-ASCII.
ENV LANG=C.UTF-8

# ~/.bb holds server state. It is created in the image so the copy-up into a home
# volume carries the right uid/gid: a volume created empty would be root-owned
# and bb could not write to it.
RUN mkdir -p /home/${USERNAME}/.bb

COPY --chown=$USERNAME:$USERNAME container/entrypoint.sh /home/${USERNAME}/entrypoint.sh

# The hydration registry is stamped by developer with an atomic rename, so its
# directory, not just the files copied into it, must be developer-owned.
USER root
RUN install -d -o "$USERNAME" -g "$USERNAME" /usr/local/share/bb
USER $USERNAME

# Home hydration. The same registry chain ships to every variant: the shared
# guidance keeps the wording flavor-neutral, so a volume that moved from one
# flavor to another is hydrated by hash as if the image itself moved on. The
# registry and pristine sources live under /usr/local/share/bb, outside the
# volume, and the entrypoint hydrates them on every start
# (container/hydrate-home.sh). Copies a user edited are left alone.
#
# This block sits last so that editing a managed source rebuilds only these
# layers. Above the toolset COPY, an AGENTS.md edit would invalidate the mise
# toolset layers and re-download the baked dev tools.
COPY --chown=$USERNAME:$USERNAME container/agents.md container/rc-bash.sh \
    container/rc-zsh.sh container/managed.tsv container/managed-prev.tsv \
    container/hydrate-home.sh /usr/local/share/bb/

RUN bash /usr/local/share/bb/hydrate-home.sh stamp \
    && HOME=/home/${USERNAME} bash /usr/local/share/bb/hydrate-home.sh install

CMD ["bash", "/home/developer/entrypoint.sh"]

# Identity marker: the check harness refuses to run this image's checks as
# another flavor, so a slim build can never pass because it was verified as
# full, and vice versa. sudo stages stamp their own flavor over the one they
# inherit.
LABEL sh.bb.flavor="slim"

# ---------------------------------------------------------------------------
# slim-sudo: everything in slim, plus passwordless sudo, so an agent can add
# apt packages, system users or anything else an interactive environment
# assembly needs. Launching it is a deliberate security step down: passwordless
# sudo means setuid works, so the container must be started WITHOUT
# --security-opt no-new-privileges (the Makefile derives that flag from the
# flavor). Host access stays bounded by the rootless container itself.
# ---------------------------------------------------------------------------

FROM slim AS slim-sudo

ARG USERNAME

USER root
RUN set -e; \
    apt-get update \
    && apt-get install -y --no-install-recommends sudo \
    && rm -rf /var/lib/apt/lists/*
COPY --chmod=0440 container/sudoers-developer /etc/sudoers.d/developer
USER $USERNAME

# Same default command as the flavor below it; only the launch policy differs.
CMD ["bash", "/home/developer/entrypoint.sh"]

# Identity marker: the check harness refuses to run this image's checks as
# another flavor, so a slim build can never pass because it was verified as
# full, and vice versa. sudo stages stamp their own flavor over the one they
# inherit.
LABEL sh.bb.flavor="slim-sudo"

# ---------------------------------------------------------------------------
# full-sudo: the batteries-included work environment plus passwordless sudo,
# for long-lived development containers and bb source development.
# ---------------------------------------------------------------------------

FROM full AS full-sudo

ARG USERNAME

USER root
RUN set -e; \
    apt-get update \
    && apt-get install -y --no-install-recommends sudo \
    && rm -rf /var/lib/apt/lists/*
COPY --chmod=0440 container/sudoers-developer /etc/sudoers.d/developer
USER $USERNAME

CMD ["bash", "/home/developer/entrypoint.sh"]

# Identity marker: the check harness refuses to run this image's checks as
# another flavor, so a slim build can never pass because it was verified as
# full, and vice versa. sudo stages stamp their own flavor over the one they
# inherit.
LABEL sh.bb.flavor="full-sudo"

# ---------------------------------------------------------------------------
# Final alias. Bare builds (no --target) and TARGET=release produce the same
# artifact: the default full image behind today's unsuffixed tags. A stage with
# no instructions adds nothing; it exists so that naming a target explicitly
# and not naming one cannot diverge. New variants are appended as stages above
# this one; nothing follows it, or bare builds would silently change target.
# ---------------------------------------------------------------------------

FROM full AS release
