# Image-owned listener default for the systemd VM flavors. Override a value in
# /etc/default/bb, which the service reads after this file; bb's own
# ~/.bb/env.json outranks both. A routable listener is an explicit opt-in and
# needs a service restart. See docs/running.md.
BB_SERVER_BIND_HOST=127.0.0.1
BB_SERVER_PORT=38886
