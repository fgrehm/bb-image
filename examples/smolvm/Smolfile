# Run bb-image as a smolvm microVM: https://smolmachines.com
#
# This image is consumed as-is. A Smolfile's `image` takes an OCI reference, a
# `podman save` / `docker save` archive, or an unpacked rootfs, so nothing needs
# repackaging, and a local archive needs no registry pull at all. A registry
# reference is pulled from inside the guest, which is one reason networking has to
# be on.
#
# Until 0.2.0, the pullable tag was `edge`. Pin an exact build with `img-0.2.0`, or use a
# bb version tag such as `0.44.0` to follow the bb release even when the image has not
# been rebuilt.
#
#   smolvm machine create --name bb --smolfile examples/smolvm/Smolfile
#   smolvm machine start --name bb
#
# Offline variant, no registry and no pull:
#
#   podman save ghcr.io/fgrehm/bb:edge -o bb.tar
#   smolvm machine create --name bb --smolfile examples/smolvm/Smolfile --image ./bb.tar
#
# Verified with smolvm 1.16.0 on Linux x86_64 with KVM. The image is linux/amd64
# only, so on Apple Silicon it needs `rosetta = true`.

# Pin to the 0.2.0 image for reproducible machines, or leave `edge` to ride main.
image = "ghcr.io/fgrehm/bb:img-0.2.0"

# bb needs outbound access for provider APIs, git, and package installs. Note that with
# networking on and no token, mise resolves the unpinned agent CLIs against the GitHub
# API unauthenticated, which allows 60 requests per hour and then fails with 403s that do
# not read as rate limiting. The [secrets] block at the bottom of this file is the fix.
net = true

[dev]
# bb serves on 38886. Publishing a port needs networking, which is on above.
ports = ["38886:38886"]

# bb answers its own API without auth, so `smolvm machine monitor` can watch it
# instead of guessing at a startup delay.
[health]
exec = ["curl", "-fsS", "http://127.0.0.1:38886/api/v1/hosts"]
interval = "30s"
timeout = "5s"
retries = 3
startup_grace = "60s"

# Without a token, mise resolves the unpinned agent CLIs unauthenticated against the
# GitHub API, which allows 60 requests per hour and then fails with 403s that do not
# read as rate limiting. Only a host environment variable or a host file can be
# referenced, never a command, so `gh auth token` has to be materialised before launch:
#
#   GH_TOKEN="$(gh auth token)" smolvm machine create --name bb \
#     --smolfile examples/smolvm/Smolfile
#
# An unset variable fails the launch with `resolve secret: env_unset` rather than
# injecting an empty value, so a machine never starts silently unauthenticated.
# References resolve per launch, so a rotated token needs no re-sync. Only the
# reference is stored, never the value, though the guest does see it in its own
# process environment.
#
# [secrets]
# GITHUB_TOKEN = { from_env = "GH_TOKEN" }
